/* ==========================================================
   DATABASE MANAGER - MODERN DARK STYLE
   ========================================================== */

* {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: #E6EAF0;
}


/* ==========================================================
   MAIN WINDOW
   ========================================================== */

QMainWindow,
QWidget {
    background: #181C24;
}


/* ==========================================================
   SIDEBAR
   ========================================================== */

QWidget[sidebar="true"] {
    background: #141820;
}

QLabel#app_title,
QLabel {
    background: transparent;
}

NavButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding-left: 14px;
    font-weight: 500;
}

NavButton:hover {
    background: #232A35;
}

NavButton:checked {
    background: #2979FF;
    color: white;
    font-weight: 600;
}


/* ==========================================================
   TITLES
   ========================================================== */

QLabel {
    background: transparent;
}

QLabel[title="true"] {
    font-size: 20px;
    font-weight: 700;
}


/* ==========================================================
   BUTTONS
   ========================================================== */

QPushButton {
    background: #30466c;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background: #2676f8;
}

QPushButton:pressed {
    background: #2268DA;
}

QPushButton:disabled {
    background: #313844;
    color: #8B95A7;
}


/* ==========================================================
   INPUTS
   ========================================================== */

QLineEdit,
QComboBox,
QDateEdit,
QTimeEdit {
    background: #232A35;
    border: 1px solid #2F3744;
    border-radius: 8px;
    padding: 6px 6px;
   
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus {
    border: 1px solid #2979FF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}


/* ==========================================================
   GROUP BOXES
   ========================================================== */

QGroupBox {
    background: #202631;
    border: 1px solid #2F3744;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 2px;
}


/* ==========================================================
   CARDS
   ========================================================== */

StatCard {
    background: #202631;
    border: 1px solid #2F3744;
    border-radius: 12px;
}

StatCard QLabel {
    background: transparent;
}

StatCard QLabel:nth-child(2) {
    font-size: 22px;
    font-weight: 700;
}


/* ==========================================================
   PANELS / FRAMES
   ========================================================== */

QFrame {
    background: #202631;
    border-radius: 10px;
}

ChartPlaceholder {
    background: #232A35;
    border: 1px dashed #3C4657;
    border-radius: 8px;
}


/* ==========================================================
   TABLES
   ========================================================== */
z
QTableWidget {
    background: #d0d6e0;
    border: 1px solid #2F3744;
    border-radius: 10px;
    gridline-color: #526380;
    selection-background-color: #2979FF;
    selection-color: white;
}

QHeaderView::section {
    background: #dbe0e8;
    border: none;
    border-bottom: 1px solid #2F3744;
    padding: 8px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: #232A35;
    border: none;
}

QTableWidget::item {
    padding: 6px;
    background : #2979FF ;
}

QTableWidget::item:selected {
    background: #2979FF;
}


/* ==========================================================
   SCROLLBARS
   ========================================================== */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #3A4555;
    border-radius: 5px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #3A4555;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* ==========================================================
   SPLITTER
   ========================================================== */

QSplitter::handle {
    background: #2F3744;
    width: 2px;
}


/* ==========================================================
   PROGRESS BAR
   ========================================================== */

QProgressBar {
    background: #232A35;
    border: 1px solid #2F3744;
    border-radius: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: #2979FF;
    border-radius: 7px;
}


/* ==========================================================
   DIALOGS
   ========================================================== */

QDialog {
    background: #181C24;
}


/* ==========================================================
   SEPARATORS
   ========================================================== */

QFrame[frameShape="4"] {
    background: #2F3744;
    min-height: 1px;
    max-height: 1px;
}