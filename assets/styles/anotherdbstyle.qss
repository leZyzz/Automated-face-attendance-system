/* ── GLOBAL DEFAULTS ─────────────────────────────────────────── */
QMainWindow,  QStackedWidget {
    background-color: #121212;
}
QDialog {
    background-color: #1e1d1d;
}
QWidget {
    color: #E5E5E5;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 12px;
}

/* FIX: Removes the annoying background box from all text labels */
QLabel {
    background-color: transparent;
    border: none;
}

/* ── SIDEBAR ─────────────────────────────────────────────────── */
QMainWindow > QWidget > QWidget:first-child {
    background-color: #1E1E1E;
    border-right: 1px solid #333333;
}

NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #A3A3A3;
    font-size: 13px;
    padding: 8px 12px;
    text-align: left;
}
NavButton:hover {
    background-color: #2A2A2A;
    color: #E5E5E5;
}
NavButton:checked {
    background-color: #2A2A2A;
    color: #3B82F6;
    font-weight: bold;
    border-left: 3px solid #2563EB;
    border-radius: 0px;
}

/* ── CONTAINERS & CARDS ──────────────────────────────────────── */
QFrame, StatCard, ChartPlaceholder {
    background-color: #1E1E1E;
    border-radius: 8px;
}

/* ── QGROUPBOX (Fixes title overlap) ─────────────────────────── */
QGroupBox {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    margin-top: 24px; 
    padding-top: 16px;
    color: #E5E5E5;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    background-color: #1E1E1E; /* Masks the border line beneath the text */
    color: #A3A3A3;
    padding: 0 2px;
    border-radius: 4px;
}

/* ── FIX: INPUTS, COMBOBOXES & DATEPICKERS ───────────────────── */
QLineEdit, QComboBox, QDateEdit, QTimeEdit {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #E5E5E5;
    padding: 3px;
    min-height: 16px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid #2563EB;
    background-color: #333333;
}

/* Fixes the colored bounding artifacts outside the dropdown arrows */
QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down {
    border: none;
    width: 24px;
    background-color: transparent; 
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    selection-background-color: #2563EB;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px;
}

/* Calendar Popup Fixes */
QCalendarWidget QWidget {
    background-color: #1E1E1E;
    color: #E5E5E5;
}
QCalendarWidget QToolButton {
    color: #E5E5E5;
    background-color: transparent;
}
QCalendarWidget QToolButton:hover {
    background-color: #2A2A2A;
}
QCalendarWidget QSpinBox {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #E5E5E5;
    padding: 2px;
    margin-right: 4px;
}

/* ── FIX: SESSION SETUP SEPARATION ───────────────────────────── */
/* An invisible, wide handle creates a rigid margin between left/right panes */
QSplitter::handle {
    background-color: transparent;
    width: 32px; 
}

/* ── TABLES ──────────────────────────────────────────────────── */
QTableWidget {
    background-color: #1E1E1E;
    alternate-background-color: #121212;
    border: 1px solid #333333;
    border-radius: 6px;
    gridline-color: #333333;
    outline: none;
}
QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #333333;
}
QTableWidget::item:selected {
    background-color: #2A2A2A;
    color: #3B82F6;
    border-left: 2px solid #2563EB;
}
QHeaderView::section {
    background-color: #1E1E1E;
    color: #A3A3A3;
    font-weight: bold;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #333333;
}

/* ── BUTTONS ─────────────────────────────────────────────────── */
QPushButton {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #E5E5E5;
    padding: 6px 16px;
    font-weight: bold;
    min-height: 24px;
}
QPushButton:hover {
    background-color: #383838;
}
QPushButton:disabled {
    background-color: #121212;
    color: #555555;
    border: 1px solid #333333;
}


/* FIX: Constrain Create Session button to match input box width */
QPushButton[text="Create Session"] {
    background-color: #2563EB;
    border: none;
    color: #FFFFFF;
    max-width: 220px; 
    margin-top: 8px;
}

QPushButton[text="Save Student"]:hover, QPushButton[text="Import All"]:hover,
QPushButton[text="Create Session"]:hover, QPushButton[text="Confirm"]:hover {
    background-color: #3B82F6;
}

/* Danger Actions */
QPushButton[text="Delete Selected"] {
    background-color: #121212;
    border: 1px solid #7F1D1D;
    color: #F87171;
}
QPushButton[text="Delete Selected"]:hover {
    background-color: #7F1D1D;
    color: #FFFFFF;
}

/* ── SCROLLBARS ──────────────────────────────────────────────── */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 8px;
    height: 8px;
}
QScrollBar::handle {
    background: #333333;
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: #A3A3A3;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px; height: 0px;
}